[Unit]
Description=Fitbit MCP local HTTP service
Documentation=https://github.com/aksm25/fitbit-mcp
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Documents/Codex/fitbit-mcp
ExecStart=/usr/bin/node %h/Documents/Codex/fitbit-mcp/dist/index.js --http
Environment=NODE_ENV=production
Environment=TZ=America/New_York
Environment=FITBIT_MCP_TRANSPORT=http
Environment=FITBIT_MCP_HOST=127.0.0.1
Environment=FITBIT_MCP_PORT=8010
Environment=FITBIT_MCP_ALLOWED_ORIGIN=http://127.0.0.1:8010
Restart=on-failure
RestartSec=10s
TimeoutStopSec=20s
UMask=0077

# The service can read the code and local OAuth config, but can only write to
# its private Fitbit/profile state directories (needed for token refresh).
NoNewPrivileges=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectHome=read-only
# PrivateDevices, ProtectKernelLogs and ProtectKernelModules are omitted because
# this laptop's unprivileged user manager rejects their capability drop.
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=-%h/.fitbit-mcp -%h/.delx-wellness
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
TasksMax=256
MemoryMax=512M

[Install]
WantedBy=default.target
